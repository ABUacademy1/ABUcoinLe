        print(RED + "❌ Amount exceeds your balance!" + RESET)
        return

    tx_data = {
        "type": "sent",
        "from": sender,
        "to": receiver,
        "receiver_id": receiver_id,
        "sender_id": USER_ID,
        "amount": amount,
        "tx_id": hashlib.sha256(os.urandom(16)).hexdigest(),
        "timestamp": time.time()
    }

    encrypted = encrypt_data(tx_data)
    tx_hash = hashlib.sha256(encrypted.encode()).hexdigest()
    path = os.path.join(PICTURES_PATH, f"tx_{tx_hash[:10]}.sim")

    with open(path, "w") as f:
        f.write(encrypted)

    qr = qrcode.make(encrypted)
    qr.save(path.replace(".sim", ".png"))

    print(GREEN + "✅  TX saved and encrypted:" + RESET, path)
    print("\n📋 Currency Code (Copy this):\n")
    print(YELLOW + encrypted + RESET)
    print("\n📌 Send this code to receiver\n")

    save_history(tx_data)
    set_balance(user_balance - amount)
    print(f"💸 {amount} ABULe deducted. New balance: {get_balance()} ABULe")

    start_timer_thread(tx_data["timestamp"])

# ---------------- RECEIVE FROM FILE ---------------- #
def receive_all_sim():
    header()
    user_balance = get_balance()
    found = []

    for root, dirs, files in os.walk(PICTURES_PATH):
        for file in files:
            if file.startswith("tx_") and file.endswith(".sim"):
                found.append(os.path.join(root, file))

    if not found:
        print(RED + "❌ No new simulated transactions" + RESET)
        return

    total_added = 0
    for i, path in enumerate(found):
        enc = open(path).read()
        code_hash = hashlib.sha256(enc.encode()).hexdigest()
        if is_code_used(code_hash):
            continue

        data = decrypt_data(enc)

        if data.get("receiver_id") != USER_ID:
            print(RED + f"{i+1}) Skipped (Wrong User ID)" + RESET)
            continue

        if is_expired(data["timestamp"]):
            print(RED + f"{i+1}) Code expired, skipped" + RESET)
            os.remove(path)
            continue

        print(f"{i+1}) FROM: {data['from']} → TO: {data['to']} | {data['amount']} ABULe")

        history_entry = data.copy()
        history_entry["type"] = "received_file"
        save_history(history_entry)

        mark_code_used(code_hash)
        os.remove(path)
        total_added += data['amount']

    if total_added > 0:
        set_balance(user_balance + total_added)
        print(GREEN + f"💰 Total received: {total_added} ABULe added. New balance: {get_balance()} ABULe" + RESET)

