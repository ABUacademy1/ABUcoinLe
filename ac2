# ---------------- ANTI DUPLICATE ---------------- #
def is_code_used(code_hash):
    if not os.path.exists(DB_FILE):
        return False
    return code_hash in open(DB_FILE).read().splitlines()

def mark_code_used(code_hash):
    with open(DB_FILE, "a") as f:
        f.write(code_hash + "\n")

# ---------------- EXPIRY ---------------- #
def is_expired(timestamp):
    return (time.time() - timestamp) > 120

# ---------------- TIMER THREAD ---------------- #
def start_timer_thread(timestamp):
    def timer():
        total = 120
        while True:
            elapsed = int(time.time() - timestamp)
            remaining = total - elapsed
            if remaining <= 0:
                print("\r⏰ EXPIRED!                           ")
                break
            progress = int((elapsed / total) * 30)
            bar = "█" * progress + "-" * (30 - progress)
            print(f"\r⏳ [{bar}] {remaining}s left", end="")
            time.sleep(1)
    t = threading.Thread(target=timer, daemon=True)
    t.start()

# ---------------- CREATE SIMULATED TX ---------------- #
def create_tx_sim():
